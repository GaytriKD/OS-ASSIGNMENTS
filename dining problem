#include <iostream>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

using namespace std;

#define N 5

sem_t forks[N];
sem_t mutex;

enum
{
    THINKING,
    HUNGRY,
    EATING
};

int state[N];

void test(int i)
{
    if(state[i] == HUNGRY &&
       state[(i + 4) % N] != EATING &&
       state[(i + 1) % N] != EATING)
    {
        state[i] = EATING;

        cout << "Philosopher "
             << i + 1
             << " takes forks "
             << (i + 4) % N + 1
             << " and "
             << i + 1
             << endl;

        cout << "Philosopher "
             << i + 1
             << " is EATING"
             << endl;

        sem_post(&forks[i]);
    }
}

void take_fork(int i)
{
    sem_wait(&mutex);

    state[i] = HUNGRY;

    cout << "Philosopher "
         << i + 1
         << " is HUNGRY"
         << endl;

    test(i);

    sem_post(&mutex);

    sem_wait(&forks[i]);
}

void put_fork(int i)
{
    sem_wait(&mutex);

    state[i] = THINKING;

    cout << "Philosopher "
         << i + 1
         << " puts forks "
         << (i + 4) % N + 1
         << " and "
         << i + 1
         << endl;

    cout << "Philosopher "
         << i + 1
         << " is THINKING"
         << endl;

    test((i + 4) % N);
    test((i + 1) % N);

    sem_post(&mutex);
}

void* philosopher(void* num)
{
    int i = *(int*)num;

    while(true)
    {
        sleep(1);

        cout << "Philosopher "
             << i + 1
             << " is THINKING"
             << endl;

        sleep(1);

        take_fork(i);

        sleep(2);

        put_fork(i);
    }

    return NULL;
}

int main()
{
    pthread_t thread_id[N];
    int phil[N];

    sem_init(&mutex, 0, 1);

    for(int i = 0; i < N; i++)
    {
        sem_init(&forks[i], 0, 0);
        phil[i] = i;
    }

    for(int i = 0; i < N; i++)
    {
        pthread_create(&thread_id[i],
                       NULL,
                       philosopher,
                       &phil[i]);
    }

    for(int i = 0; i < N; i++)
    {
        pthread_join(thread_id[i], NULL);
    }

    return 0;
}
