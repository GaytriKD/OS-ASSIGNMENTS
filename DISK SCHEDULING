#include <iostream>
#include <algorithm>
#include <cmath>
using namespace std;

void SCAN(int arr[], int n, int head, int disk_size) {
    int seek_count = 0;
    int left[50], right[50];
    int l = 0, r = 0;

    for (int i = 0; i < n; i++) {
        if (arr[i] < head)
            left[l++] = arr[i];
        else
            right[r++] = arr[i];
    }

    sort(left, left + l);
    sort(right, right + r);

    cout << "Seek Sequence: ";

    for (int i = 0; i < r; i++) {
        cout << right[i] << " ";
        seek_count += abs(head - right[i]);
        head = right[i];
    }

    seek_count += abs(head - (disk_size - 1));
    head = disk_size - 1;

    for (int i = l - 1; i >= 0; i--) {
        cout << left[i] << " ";
        seek_count += abs(head - left[i]);
        head = left[i];
    }

    cout << "\nTotal Seek Operations: " << seek_count << endl;
    cout << "Average Seek Time: " << (float)seek_count / n << endl;
}

void CSCAN(int arr[], int n, int head, int disk_size) {
    int seek_count = 0;
    int left[50], right[50];
    int l = 0, r = 0;

    for (int i = 0; i < n; i++) {
        if (arr[i] < head)
            left[l++] = arr[i];
        else
            right[r++] = arr[i];
    }

    sort(left, left + l);
    sort(right, right + r);

    cout << "Seek Sequence: ";

    for (int i = 0; i < r; i++) {
        cout << right[i] << " ";
        seek_count += abs(head - right[i]);
        head = right[i];
    }

    seek_count += abs(head - (disk_size - 1));
    head = 0;
    seek_count += disk_size - 1;

    for (int i = 0; i < l; i++) {
        cout << left[i] << " ";
        seek_count += abs(head - left[i]);
        head = left[i];
    }

    cout << "\nTotal Seek Operations: " << seek_count << endl;
    cout << "Average Seek Time: " << (float)seek_count / n << endl;
}

void FCFS(int queue[], int n, int head) {
    int total = 0;

    for (int i = 0; i < n; i++) {
        total += abs(head - queue[i]);
        head = queue[i];
    }

    cout << "Total Seek Operations: " << total << endl;
    cout << "Average Seek Time: " << (float)total / n << endl;
}

void SSTF(int queue[], int n, int head) {
    bool visited[50] = {false};
    int total = 0;

    for (int i = 0; i < n; i++) {
        int minDist = 1e9;
        int index = -1;

        for (int j = 0; j < n; j++) {
            if (!visited[j]) {
                int dist = abs(head - queue[j]);
                if (dist < minDist) {
                    minDist = dist;
                    index = j;
                }
            }
        }

        visited[index] = true;
        total += minDist;
        head = queue[index];
    }

    cout << "Total Seek Operations: " << total << endl;
    cout << "Average Seek Time: " << (float)total / n << endl;
}

int main() {
    int n, head, disk_size;

    cout << "Enter number of requests: ";
    cin >> n;

    int arr[50];

    cout << "Enter requests: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter initial head position: ";
    cin >> head;

    cout << "Enter disk size: ";
    cin >> disk_size;

    cout << "\nSCAN Algorithm:\n";
    SCAN(arr, n, head, disk_size);

    cout << "\nC-SCAN Algorithm:\n";
    CSCAN(arr, n, head, disk_size);

    cout << "\nFCFS Algorithm:\n";
    FCFS(arr, n, head);

    cout << "\nSSTF Algorithm:\n";
    SSTF(arr, n, head);

    return 0;
}
