#include <iostream>
#include <queue>
using namespace std;


void displayTable(int n,int at[],int bt[],int ct[])
{
    int wt[50],tat[50];
    float avgwt=0,avgtat=0;

    cout<<"\nProcess\tAT\tBT\tCT\tWT\tTAT\n";

    for(int i=0;i<n;i++)
    {
        tat[i]=ct[i]-at[i];
        wt[i]=tat[i]-bt[i];

        avgwt+=wt[i];
        avgtat+=tat[i];

        cout<<"P"<<i+1<<"\t"<<at[i]<<"\t"<<bt[i]<<"\t"<<ct[i]<<"\t"<<wt[i]<<"\t"<<tat[i]<<"\n";
    }

    cout<<"\nAverage Waiting Time = "<<avgwt/n;
    cout<<"\nAverage Turnaround Time = "<<avgtat/n<<"\n";
}

void sortByArrival(int n, int at[], int bt[])
{
    for(int i=0;i<n-1;i++)
    {
        for(int j=i+1;j<n;j++)
        {
            if(at[i] > at[j])
            {
                int temp = at[i];
                at[i] = at[j];
                at[j] = temp;

                temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;
            }
        }
    }
}

void fcfs()
{
    
    int s=0;
    int n,time=0;
    cout<<"Enter no. of processes: ";
    cin>>n;

    int at[50],bt[50],ct[50];

    cout<<"Enter Arrival Times:\n";
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>at[i];
    }

    cout<<"Enter Burst Times:\n";
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>bt[i];
    }

    sortByArrival(n, at, bt);
    cout<<"\nGantt Chart\n|";

    for(int i=0;i<n;i++)
    {
        if(time <=at[i]){
            time=at[i];
        }
        cout<<s<<"  ";
        cout<<" P"<<i+1<<" |";
        time+=bt[i];
        ct[i]=time;
        s=ct[i];
    }

    displayTable(n,at,bt,ct);
}


void sjf()
{
    int n;
    int time=0;
    int k=0;
    cout<<"Enter no. of processes: ";
    cin>>n;

    int at[50],bt[50],ct[50],visited[50]={0},order[50];

    cout<<"Enter Arrival Times:\n";
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>at[i];
    }

    cout<<"Enter Burst Times:\n";
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>bt[i];
    }
    int p; 
    while(k<n)
    {
        p=-1;
        for(int i=0;i<n;i++)
        {
            if(at[i]<=time && visited[i]==0)
            {
                if(p==-1 || bt[i]<bt[p])
                    p=i;
            }
        }

        if(p==-1) time++;
        else{
            time+=bt[p];
            ct[p]=time;
            visited[p]=1;
            order[k]=p;
            k++;
        }
    }

    cout<<"\nGantt Chart\n|";
    for(int i=0;i<n;i++) {
        cout<<" P"<<order[i]+1<<" |";
    }
    cout<<endl;

    displayTable(n,at,bt,ct);
}


void srtf()
{
    int n;
    int time=0;
    int k=0;
    cout<<"Enter no. of processes: ";
    cin>>n;

    int at[50],bt[50],rt[50],ct[50],order[200];

    cout<<"Enter Arrival Times:"<<endl;
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>at[i];
    }

    cout<<"Enter Burst Times:"<<endl;
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>bt[i];
        rt[i]=bt[i];
    }
    int p;

    while(k<n)
    {
        p=-1;
        for(int i=0;i<n;i++)
        {
            if(at[i]<=time && rt[i]>0)
            {
                if(p==-1 || rt[i]<rt[p])
                    p=i;
            }
        }

        if(p==-1) time++;
        else{
            order[k]=p;
            k++;
            rt[p]--;
            time++;

            if(rt[p]==0){
                ct[p]=time;
                k++;
            }
        }
    }

    cout<<"\nGantt Chart\n|";
    for(int i=0;i<k;i++) {
        cout<<" P"<<order[i]+1<<" |";
    }
    cout<<endl;

    displayTable(n,at,bt,ct);
}


