void roundRobin()
{
    int n, tq;
    cout<<"Enter no. of processes: ";
    cin>>n;

    cout<<"Enter Time Quantum: ";
    cin>>tq;

    int at[50], bt[50], rt[50], ct[50];
    int order[200], k = 0;

    cout << "Enter Arrival Times:\n";
    for (int i = 0; i < n; i++) {
        cout << "P" << i + 1 << ": ";
        cin >> at[i];
    }

    cout << "Enter Burst Times:\n";
    for (int i = 0; i < n; i++) {
        cout << "P" << i + 1 << ": ";
        cin >> bt[i];
        rt[i] = bt[i];
    }

    queue<int> q;
    bool inQueue[50] = {false};

    int time = 0, p = 0;

    for (int i = 0; i < n; i++) {
        if (at[i] == 0) {
            q.push(i);
            inQueue[i] = true;
        }
    }

    while (p < n)
    {
        if (q.empty()) {
            time++;
            for (int i = 0; i < n; i++) {
                if (at[i] <= time && rt[i] > 0 && !inQueue[i]) {
                    q.push(i);
                    inQueue[i] = true;
                }
            }
            continue;
        }

        int i = q.front();
        q.pop();

        order[k] = i;
        k++;

        int execTime = min(tq, rt[i]);
        time += execTime;
        rt[i] -= execTime;

        for (int j = 0; j < n; j++) {
            if (at[j] <= time && rt[j] > 0 && !inQueue[j]) {
                q.push(j);
                inQueue[j] = true;
            }
        }

        if (rt[i] > 0) {
            q.push(i);
        } else {
            ct[i] = time;
            k++;
        }
    }

    cout << "\nGantt Chart:\n|";
    for (int i = 0; i < k; i++) {
        cout << " P" << order[i] + 1 << " |";
    }
    cout << endl;

    displayTable(n,at,bt,ct);
}


void priorityP() 
{
    int n;
    int time=0;
    int k=0;
    cout<<"Enter no. of processes: "<<endl;
    cin>>n;

    int at[50],bt[50],rt[50],pr[50],ct[50];
    int order[100];

    cout<<"Enter Arrival Times:\n";
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>at[i];
    }

    cout<<"Enter Burst Times:\n";
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>bt[i];
        rt[i]=bt[i];
    }

    //smaller number - higher priority
    cout<<"Enter Priorities:\n";
    for(int i=0;i<n;i++){
        cout<<"P"<<i+1<<": ";
        cin>>pr[i];
    }
    

    int p;
    while(k<n)
    {
        p=-1;

        for(int i=0;i<n;i++)
        {
            if(at[i]<=time && rt[i]>0)
            {
                if(p==-1 || pr[i]<pr[p])
                    p=i;
                else if(pr[i]==pr[p] && rt[i]<rt[p])
                    p=i;
            }
        }

        if(p==-1)
        {
            time++;
        }
        else
        {
            order[k++]=p;
            rt[p]--;
            time++;

            if(rt[p]==0)
            {
                ct[p]=time;
                k++;
            }
        }
    }

    displayTable(n, at, bt, ct);

    cout<<"\nGantt Chart:\n|";
    for(int i=0;i<k;i++)
    {
        if(i==0 || order[i]!=order[i-1])
            cout<<" P"<<order[i]+1<<" |";
    }
    cout<<endl;
}

int main()
{
    int a;
    while(1)
    {
        cout<<"\nCPU Scheduling\n";
        cout<<"1.FCFS\n2.SJF\n3.SRTF\n4.Priority Non Preemptive\n5.Round Robin\n6.Priority Preemptive\n7.Exit\n";

        cout<<"Enter a: ";
        cin>>a;

        switch(a)
        {
            case 1: fcfs(); break;
            case 2: sjf(); break;
            case 3: srtf(); break;
            case 4: priorityNonP(); break;
            case 5: roundRobin(); break;
            case 6: priorityP(); break;
            case 7: return 0;
            default: cout<<"Invalid Choice\n";
        }
    }
}
