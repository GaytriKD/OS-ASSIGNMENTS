#include <iostream>
using namespace std;

int main() {

    int Tmem, n;

    cout << "Enter total memory size: ";
    cin >> Tmem;

    cout << "Enter number of processes: ";
    cin >> n;

    int p[20];

    for(int i = 0; i < n; i++) {

        cout << "Enter memory required for process "
             << i + 1 << ": ";

        cin >> p[i];
    }

    cout << "\nProcess\tRequired\tAllocated(Buddy Block)\n";

    for(int i = 0; i < n; i++) {

        int blockSize = 1;

        // Find nearest power of 2
        while(blockSize < p[i]) {
            blockSize = blockSize * 2;
        }

        if(blockSize <= Tmem) {

            cout << "P" << i + 1
                 << "\t" << p[i]
                 << "\t\t" << blockSize
                 << endl;

            Tmem -= blockSize;
        }

        else {

            cout << "P" << i + 1
                 << "\t" << p[i]
                 << "\t\tNot Allocated"
                 << endl;
        }
    }

    cout << "\nRemaining Memory: " << Tmem << endl;

    return 0;
}
