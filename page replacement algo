int main() {
    int n, frames, choice;
    int pages[100];

    cout << "Enter no. of pages: ";
    cin >> n;

    cout << "Enter reference string: ";
    for (int i = 0; i < n; i++)
        cin >> pages[i];

    cout << "Enter no. of frames: ";
    cin >> frames;

    do {
        cout<<"\n1. FIFO\n2. LRU\n3. OPTIMAL\n4. EXIT\n";
        cout<<"Enter choice: ";
        cin>>choice;

        if (choice == 1)
            FIFO(pages, n, frames);
        else if (choice == 2)
            LRU(pages, n, frames);
        else if (choice == 3)
            OPTIMAL(pages, n, frames);
        else if (choice == 4)
            cout << "Exiting...\n";
        else
            cout << "Invalid choice!\n";

    } while (choice != 4);

    return 0;
}
